{
  "name": "my-project",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build && node scripts/copy-standalone.js",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:push:neon": "dotenv -e .env.neon -- prisma db push",
    "db:seed:neon": "dotenv -e .env.neon -- tsx prisma/seed.ts",
    "zip": "tar -a -cf deploy.zip --exclude=node_modules --exclude=.next --exclude=.git --exclude=.env --exclude=.env.* --exclude=uploads --exclude=public/uploads --exclude=deploy.zip --exclude=deploy.tar.gz ."
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",

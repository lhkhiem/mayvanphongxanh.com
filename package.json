    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sharp": "^0.32.0",
    "dotenv-cli": "^11.0.0",
    "postcss": "^8.5",
    "prisma": "^7.8.0",
    "tailwindcss": "^4.2.0",

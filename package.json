    "@vercel/analytics": "1.6.1",
    "bcryptjs": "^3.0.3",
    "ckeditor5": "^48.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "next-auth": "5.0.0-beta.31",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "react": "^19",
    "react-dom": "^19",
    "recharts": "^3.9.1",
    "shadcn": "^4.8.0",
    "sharp": "^0.35.3",
